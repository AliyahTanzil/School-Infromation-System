{
  "name": "sais-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev": "npm run dev:frontend",
    "dev:all": "node scripts/ensure-workspaces.mjs && node scripts/allocate-ports.mjs && concurrently -k -n backend,frontend -c blue,green \"node scripts/start-backend.mjs\" \"node scripts/wait-for-backend.mjs\"",
    "build:frontend": "npm run build -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "eslint .",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node .husky/prepare.mjs",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.37",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.59",
    "mammoth": "^1.12.1",
    "npm": "^11.19.0",
    "prisma": "^6.19.0"
  }
}
