{
  "name": "sais-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "node --env-file-if-exists=/vercel/share/.env.project ./node_modules/npm/bin/npm-cli.js run dev -w backend",
    "dev:frontend": "node --env-file-if-exists=/vercel/share/.env.project ./node_modules/npm/bin/npm-cli.js run dev -w frontend",
    "dev": "node --env-file-if-exists=/vercel/share/.env.project ./node_modules/npm/bin/npm-cli.js run dev:all",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev -w frontend\"",
    "build:frontend": "npm run build -w frontend",
    "lint": "eslint .",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:frontend": "npm run test -w frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node .husky/prepare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "globals": "^15.9.0",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,json,md,yaml,yml}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.37",
    "ai": "^7.0.59",
    "cookie-parser": "^1.4.7",
    "npm": "^11.19.0"
  }
}
