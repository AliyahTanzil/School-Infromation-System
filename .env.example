# ══════════════════════════════════════════════════════════
# SAIS — Environment Variables
# Copy this file to .env and fill in real values.
# This file is committed; .env is gitignored.
# ══════════════════════════════════════════════════════════

# ─── Docker Compose / PostgreSQL ──────────────────────────
POSTGRES_DB=sais
POSTGRES_USER=sais
POSTGRES_PASSWORD=

# ─── pgAdmin ──────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# ─── Application ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Enable only behind a known single reverse proxy; controls Express client-IP resolution.
TRUST_PROXY=false

# ─── Database (app connection string) ─────────────────────
DATABASE_URL=

# Optional only when the database contains exactly one School row. Required
# during a staged conversion if legacy data contains multiple schools.
SINGLE_SCHOOL_ID=
SINGLE_SCHOOL_NAME=Aunty Isha International Academy
SINGLE_SCHOOL_CODE=AIIA

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGINS=5
MAX_FAILED_LOGINS_PER_IP=25
ACCOUNT_LOCKOUT_MINUTES=15

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d
LOG_ZIPPED_ARCHIVE=true
