# ══════════════════════════════════════════════════════════
# SAIS — Environment Variables
# Copy this file to .env and fill in real values.
# This file is committed; .env is gitignored.
# ══════════════════════════════════════════════════════════

# ─── Docker Compose / PostgreSQL ──────────────────────────
POSTGRES_DB=sais
POSTGRES_USER=sais
POSTGRES_PASSWORD=sais_password

# ─── pgAdmin ──────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@sais.local
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Application ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─── Database (app connection string) ─────────────────────
DATABASE_URL=postgresql://sais:sais_password@postgres:5432/sais?schema=public

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d
LOG_ZIPPED_ARCHIVE=true
