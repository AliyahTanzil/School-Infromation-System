  subjectCode String
  kind        String   @default("LESSON")
  duration    Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  timeSlot    TimetableSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  class       Class? @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  room        TimetableRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teachingAssignment TeacherTeachingAssignment? @relation(fields: [teachingAssignmentId], references: [id], onDelete: SetNull)

  @@index([timetableId, timeSlotId])
  @@unique([timetableId, timeSlotId, classId])
  @@unique([timetableId, timeSlotId, teacherId])
  @@index([tenantId, schoolId, teacherId, timeSlotId])
}

model SchedulingConflict {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  schoolId    String    @db.Uuid
  timetableId String    @db.Uuid
  entryId     String    @db.Uuid
  code        String
  severity    String
  message     String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([timetableId, severity, resolvedAt])
}

model TimetableVersion {
  id          String   @id @default(uuid()) @db.Uuid
  timetableId String   @db.Uuid
  number      Int
  snapshot    Json
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([timetableId, number])
}

model TimetableAudit {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
  timetableId String   @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([timetableId, createdAt])
}

model ScheduleSubstitution {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  schoolId            String   @db.Uuid
  timetableId         String   @db.Uuid
  entryId             String   @db.Uuid
  originalTeacherId   String?  @db.Uuid
  substituteTeacherId String?  @db.Uuid
  reason              String
  startsAt            DateTime
  endsAt              DateTime
  createdBy           String?  @db.Uuid
  createdAt           DateTime @default(now())
  timetable           Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([timetableId, startsAt, endsAt])
}

model ClassroomLiveSession {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  schoolId       String           @db.Uuid
  classroomId    String           @db.Uuid
  hostId         String           @db.Uuid
  title          String
  description    String?
  scheduledAt    DateTime
  endedAt        DateTime?
  status         String           @default("SCHEDULED")
  meetingUrl     String?
  roomCode       String?
  recordingUrl   String?
  recordingTitle String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  classroom      DigitalClassroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  host           User             @relation("LiveSessionHost", fields: [hostId], references: [id], onDelete: Restrict)

  @@index([tenantId, schoolId, classroomId, status, scheduledAt])
}
