generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  OWNER
  SUPPORT
  AUDITOR
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum AccountType {
  APPLICATION_MANAGER
  TENANT_ADMIN
  STAFF
  TEACHER
  PARENT
  STUDENT
}

enum LoginEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TOKEN_REFRESHED
  SESSION_REVOKED
  LOGGED_OUT
  LOGGED_OUT_ALL
  EMAIL_VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  TRANSFERRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  code              String             @unique
  status            TenantStatus       @default(PENDING)
  timezone          String             @default("UTC")
  currency          String             @default("USD")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  users             User[]
  schools           School[]
  roles             Role[]
  academicYears     AcademicYear[]
  students          Student[]
  guardians         Guardian[]
  staff             Staff[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  settings          TenantSetting[]

  @@index([status])
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String?                  @db.Uuid
  email              String                   @unique
  firstName          String
  lastName           String
  phone              String?
  passwordHash       String?
  accountType        AccountType              @default(TENANT_ADMIN)
  status             UserStatus               @default(INVITED)
  platformRole       PlatformRole?
  emailVerifiedAt    DateTime?
  failedLoginCount   Int                      @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  devices            UserDevice[]
  sessions           UserSession[]
  staff              Staff?
  notifications      Notification[]
  auditLogs          AuditLog[]
  loginAttempts      LoginAttempt[]
  auditLogins        AuditLogin[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  trustedDevices     TrustedDevice[]
  activationRequests ActivationRequest[]      @relation("ActivationApplicant")
  ownedActivations   ActivationRequest[]      @relation("ActivationOwner")
  profile            UserProfile?
  preference         UserPreference?
  userAudits         UserAudit[]              @relation("UserAuditSubject")
  actedUserAudits    UserAudit[]              @relation("UserAuditActor")

  @@index([tenantId, status])
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  address   String?
  city      String?
  country   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses  Campus[]

  @@unique([tenantId, code])
}

model Campus {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name     String
  code     String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  code        String
  description String?
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  revokedAt DateTime?
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserDevice {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  deviceFingerprint String
  platform          String?
  pushToken         String?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
}

model UserSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  deviceName    String?
  deviceType    String?
  deviceHash    String?
  ipAddress     String?
  userAgent     String?
  lastActiveAt  DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogins   AuditLogin[]

  @@index([userId, expiresAt])
}

model AcademicYear {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  startsOn    DateTime
  endsOn      DateTime
  isCurrent   Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms       AcademicTerm[]
  enrollments Enrollment[]

  @@unique([tenantId, name])
}

model AcademicTerm {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  name           String
  startsOn       DateTime
  endsOn         DateTime
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
}

model Student {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  admissionNumber   String
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            Gender             @default(UNSPECIFIED)
  email             String?
  phone             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([tenantId, lastName])
}

model StudentGuardian {
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  relationship String
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Staff {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  userId         String? @unique @db.Uuid
  employeeNumber String
  firstName      String
  lastName       String
  department     String?
  jobTitle       String?
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeNumber])
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  gradeLevel     String
  section        String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([tenantId, gradeLevel, section])
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  studentId      String           @db.Uuid
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus
  note           String?
  recordedById   String?          @db.Uuid
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceDate])
  @@index([tenantId, attendanceDate, status])
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  recipientId String?             @db.Uuid
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  subject     String?
  body        String
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient   User?               @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model RefreshToken {
  id            String      @id @default(uuid()) @db.Uuid
  tokenHash     String      @unique
  userId        String      @db.Uuid
  sessionId     String      @db.Uuid
  parentTokenId String?     @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, revokedAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  email         String
  ipAddress     String?
  userAgent     String?
  succeeded     Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, succeeded, createdAt])
  @@index([ipAddress, succeeded, createdAt])
}

model AuditLogin {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  sessionId String?        @db.Uuid
  event     LoginEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  session   UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  fingerprint String
  name        String?
  userAgent   String?
  lastIp      String?
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model ActivationRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  ownerUserId String    @db.Uuid
  email       String
  firstName   String?
  lastName    String?
  designation String?
  status      String    @default("PENDING")
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  applicant   User      @relation("ActivationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  owner       User      @relation("ActivationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status, createdAt])
  @@index([userId, status])
}

model UserProfile {
  userId      String  @id @db.Uuid
  designation String?
  firstName   String?
  lastName    String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  userId   String @id @db.Uuid
  locale   String @default("en")
  timezone String @default("UTC")
  settings Json?
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAudit {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  subject   User     @relation("UserAuditSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  actor     User?    @relation("UserAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
}

model DatabaseSentinel {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
}
