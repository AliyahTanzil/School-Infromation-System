generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  OWNER
  SUPPORT
  AUDITOR
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum AccountType {
  APPLICATION_MANAGER
  TENANT_ADMIN
  STAFF
  TEACHER
  PARENT
  STUDENT
}

enum LoginEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TOKEN_REFRESHED
  SESSION_REVOKED
  LOGGED_OUT
  LOGGED_OUT_ALL
  EMAIL_VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum AttendanceSessionStatus {
  DRAFT
  OPEN
  LOCKED
  ARCHIVED
}

enum AttendanceCaptureMethod {
  MANUAL
  BIOMETRIC
  QR_CODE
  IMPORT
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  TRANSFERRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

enum TeacherStatus {
  APPLICANT
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClassStatus {
  PLANNED
  ACTIVE
  CANCELLED
  ARCHIVED
}

enum AcademicPolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Tenant {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  code               String                   @unique
  status             TenantStatus             @default(PENDING)
  timezone           String                   @default("UTC")
  currency           String                   @default("USD")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  users              User[]
  schools            School[]
  roles              Role[]
  academicYears      AcademicYear[]
  students           Student[]
  guardians          Guardian[]
  staff              Staff[]
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  attendanceSessions AttendanceSession[]
  attendanceAudits   AttendanceAudit[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  settings           TenantSetting[]
  parents            Parent[]
  teachers           Teacher[]
  subjects           Subject[]
  gradeLevels        GradeLevel[]
  classrooms         Classroom[]
  classes            Class[]
  classEnrollments   ClassEnrollment[]
  gradeSchemes       GradeScheme[]
  gradeSchemeHistory GradeSchemeHistory[]
  digitalClassrooms  DigitalClassroom[]
  classroomMembers   DigitalClassroomMember[]
  timetableSettings  TimetableSettings[]
  timetableRooms     TimetableRoom[]
  teachingAssignments TeacherTeachingAssignment[]
  periodRequirements SubjectPeriodRequirement[]
  academicCalendarEvents AcademicCalendarEvent[]

  @@index([status])
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String?                  @db.Uuid
  email                  String                   @unique
  firstName              String
  lastName               String
  phone                  String?
  passwordHash           String?
  accountType            AccountType              @default(TENANT_ADMIN)
  status                 UserStatus               @default(INVITED)
  platformRole           PlatformRole?
  emailVerifiedAt        DateTime?
  failedLoginCount       Int                      @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  deletedAt              DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  tenant                 Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  roles                  UserRole[]
  devices                UserDevice[]
  sessions               UserSession[]
  staff                  Staff?
  notifications          Notification[]
  auditLogs              AuditLog[]
  loginAttempts          LoginAttempt[]
  auditLogins            AuditLogin[]
  refreshTokens          RefreshToken[]
  passwordResets         PasswordResetToken[]
  emailVerifications     EmailVerificationToken[]
  trustedDevices         TrustedDevice[]
  activationRequests     ActivationRequest[]      @relation("ActivationApplicant")
  ownedActivations       ActivationRequest[]      @relation("ActivationOwner")
  profile                UserProfile?
  preference             UserPreference?
  userAudits             UserAudit[]              @relation("UserAuditSubject")
  actedUserAudits        UserAudit[]              @relation("UserAuditActor")
  parent                 Parent?
  teacher                Teacher?
  ownedClassrooms        DigitalClassroom[]       @relation("DigitalClassroomOwner")
  classroomMemberships   DigitalClassroomMember[]
  classroomAnnouncements ClassroomAnnouncement[]
  classroomPosts         ClassroomStreamPost[]
  classroomComments      ClassroomStreamComment[]
  authoredAssignments    Assignment[]
  uploadedMaterials      DigitalMaterial[]
  studentSubmissions     StudentSubmission[]
  authoredQuizzes        Quiz[]                   @relation("QuizAuthor")
  quizAttempts           QuizAttempt[]            @relation("QuizStudent")
  authoredRubrics        Rubric[]                 @relation("RubricAuthor")
  gradedSubmissions      SubmissionGrade[]        @relation("SubmissionGrader")
  feedbackComments       GradeFeedback[]          @relation("FeedbackAuthor")
  hostedLiveSessions     ClassroomLiveSession[]   @relation("LiveSessionHost")

  @@index([tenantId, status])
}

model School {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String                   @db.Uuid
  name               String
  code               String
  address            String?
  city               String?
  country            String?
  phone              String?
  email              String?
  website            String?
  motto              String?
  logoUrl             String?
  principalName      String?
  settings           Json                     @default("{}")
  isConfigured       Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses           Campus[]
  parents            Parent[]
  teachers           Teacher[]
  subjects           Subject[]
  gradeLevels        GradeLevel[]
  classrooms         Classroom[]
  classes            Class[]
  classEnrollments   ClassEnrollment[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  attendanceAudits   AttendanceAudit[]
  gradeSchemes       GradeScheme[]
  gradeSchemeHistory GradeSchemeHistory[]
  digitalClassrooms  DigitalClassroom[]
  classroomMembers   DigitalClassroomMember[]
  timetableSettings  TimetableSettings[]
  timetableRooms     TimetableRoom[]
  teachingAssignments TeacherTeachingAssignment[]
  periodRequirements SubjectPeriodRequirement[]
  academicCalendarEvents AcademicCalendarEvent[]

  @@unique([tenantId, code])
}

model Campus {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name     String
  code     String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  code        String
  description String?
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  revokedAt DateTime?
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserDevice {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  deviceFingerprint String
  platform          String?
  pushToken         String?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
}

model UserSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  deviceName    String?
  deviceType    String?
  deviceHash    String?
  ipAddress     String?
  userAgent     String?
  lastActiveAt  DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogins   AuditLogin[]

  @@index([userId, expiresAt])
}

model AcademicYear {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  startsOn    DateTime
  endsOn      DateTime
  isCurrent   Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms       AcademicTerm[]
  enrollments Enrollment[]
  classes     Class[]
  timetables Timetable[]
  teachingAssignments TeacherTeachingAssignment[]
  periodRequirements SubjectPeriodRequirement[]

  @@unique([tenantId, name])
}

model AcademicTerm {
  id                 String              @id @default(uuid()) @db.Uuid
  academicYearId     String              @db.Uuid
  name               String
  startsOn           DateTime
  endsOn             DateTime
  status             String              @default("PLANNED")
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]
  digitalClassrooms  DigitalClassroom[]
  timetables Timetable[]
  teachingAssignments TeacherTeachingAssignment[]
  periodRequirements SubjectPeriodRequirement[]

  @@unique([academicYearId, name])
}

model AcademicCalendarEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  code        String
  type        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("PLANNED")
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId, type, startsAt])
}

model Student {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @db.Uuid
  admissionNumber     String
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              Gender                      @default(UNSPECIFIED)
  email               String?
  phone               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians           StudentGuardian[]
  enrollments         Enrollment[]
  attendanceRecords   AttendanceRecord[]
  parentRelationships ParentStudentRelationship[]
  classEnrollments    ClassEnrollment[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([tenantId, lastName])
}

model StudentGuardian {
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  relationship String
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Parent {
  id            String                      @id @default(uuid()) @db.Uuid
  tenantId      String                      @db.Uuid
  userId        String                      @unique @db.Uuid
  schoolId      String?                     @db.Uuid
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  deletedAt     DateTime?
  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School?                     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  profile       ParentProfile?
  relationships ParentStudentRelationship[]
  accessLogs    ParentAccessLog[]

  @@index([tenantId, schoolId])
}

model ParentProfile {
  parentId          String  @id @db.Uuid
  firstName         String
  lastName          String
  occupation        String?
  preferredLanguage String  @default("en")
  parent            Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model ParentStudentRelationship {
  parentId          String    @db.Uuid
  studentId         String    @db.Uuid
  relationship      String
  status            String    @default("PENDING")
  canViewAcademic   Boolean   @default(true)
  canViewAttendance Boolean   @default(true)
  canViewFees       Boolean   @default(true)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  parent            Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId, status])
}

model ParentAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  resource  String
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
}

model Teacher {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  schoolId       String                 @db.Uuid
  userId         String?                @unique @db.Uuid
  employeeNumber String
  status         TeacherStatus          @default(APPLICANT)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile        TeacherProfile?
  employment     TeacherEmployment?
  qualifications TeacherQualification[]
  certifications TeacherCertification[]
  departments    TeacherDepartment[]
  availability   TeacherAvailability[]
  history        TeacherHistory[]
  classes        ClassTeacher[]
  teachingAssignments TeacherTeachingAssignment[]
  scheduleEntries ScheduleEntry[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, schoolId, status])
}

model TeacherProfile {
  teacherId String  @id @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherEmployment {
  teacherId      String    @id @db.Uuid
  jobTitle       String
  employmentType String
  startDate      DateTime
  endDate        DateTime?
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherQualification {
  id          String    @id @default(uuid()) @db.Uuid
  teacherId   String    @db.Uuid
  title       String
  institution String?
  awardedOn   DateTime?
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model TeacherCertification {
  id        String    @id @default(uuid()) @db.Uuid
  teacherId String    @db.Uuid
  name      String
  issuer    String?
  expiresOn DateTime?
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model TeacherDepartment {
  id         String  @id @default(uuid()) @db.Uuid
  teacherId  String  @db.Uuid
  department String
  isPrimary  Boolean @default(false)
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, department])
}

model TeacherAvailability {
  id          String  @id @default(uuid()) @db.Uuid
  teacherId   String  @db.Uuid
  dayOfWeek   Int
  startsAt    String
  endsAt      String
  kind        String  @default("AVAILABLE")
  isRecurring Boolean @default(true)
  priority    Int     @default(0)
  teacher     Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
  @@index([teacherId, dayOfWeek, kind, startsAt])
}

model TeacherHistory {
  id         String        @id @default(uuid()) @db.Uuid
  teacherId  String        @db.Uuid
  fromStatus TeacherStatus
  toStatus   TeacherStatus
  reason     String?
  actorId    String?       @db.Uuid
  createdAt  DateTime      @default(now())
  teacher    Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

model Subject {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  schoolId          String             @db.Uuid
  code              String
  name              String
  description       String?
  status            SubjectStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes           ClassSubject[]
  assessmentWeights AssessmentWeight[]
  assignments       Assignment[]
  teachingAssignments TeacherTeachingAssignment[]
  periodRequirements SubjectPeriodRequirement[]
  scheduleEntries ScheduleEntry[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId, status, name])
}

model GradeScheme {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  schoolId      String               @db.Uuid
  name          String
  code          String
  passMark      Float
  status        AcademicPolicyStatus @default(DRAFT)
  effectiveFrom DateTime             @db.Date
  effectiveTo   DateTime?            @db.Date
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bands         GradeBand[]
  weights       AssessmentWeight[]
  history       GradeSchemeHistory[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId, status, effectiveFrom])
}

model GradeBand {
  id        String      @id @default(uuid()) @db.Uuid
  schemeId  String      @db.Uuid
  label     String
  minMark   Float
  maxMark   Float
  point     Float
  remark    String?
  sortOrder Int         @default(0)
  scheme    GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, label])
  @@index([schemeId, sortOrder])
}

model AssessmentWeight {
  id        String      @id @default(uuid()) @db.Uuid
  schemeId  String      @db.Uuid
  subjectId String?     @db.Uuid
  name      String
  code      String
  weight    Float
  scheme    GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizzes   Quiz[]

  @@unique([schemeId, subjectId, code])
  @@index([schemeId, subjectId])
}

model GradeSchemeHistory {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @db.Uuid
  schoolId   String               @db.Uuid
  schemeId   String               @db.Uuid
  actorId    String?              @db.Uuid
  fromStatus AcademicPolicyStatus
  toStatus   AcademicPolicyStatus
  reason     String?
  createdAt  DateTime             @default(now())
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheme     GradeScheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, schemeId, createdAt])
}

model GradeLevel {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  schoolId String  @db.Uuid
  name     String
  code     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes  Class[]

  @@unique([tenantId, schoolId, code])
}

model Classroom {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  schoolId String  @db.Uuid
  name     String
  code     String
  capacity Int
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes  Class[]

  @@unique([tenantId, schoolId, code])
}

model Class {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  schoolId           String              @db.Uuid
  academicYearId     String              @db.Uuid
  gradeLevelId       String              @db.Uuid
  classroomId        String?             @db.Uuid
  name               String
  code               String
  section            String?
  capacity           Int
  status             ClassStatus         @default(PLANNED)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  classroom          Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  enrollments        ClassEnrollment[]
  teachers           ClassTeacher[]
  subjects           ClassSubject[]
  history            ClassHistory[]
  attendanceSessions AttendanceSession[]
  DigitalClassroom   DigitalClassroom[]
  timetableEntries ScheduleEntry[]
  periodRequirements SubjectPeriodRequirement[]
  teachingAssignments TeacherTeachingAssignment[]

  @@unique([tenantId, schoolId, academicYearId, code])
  @@index([tenantId, schoolId, status])
}

model ClassEnrollment {
  classId    String           @db.Uuid
  studentId  String           @db.Uuid
  tenantId   String           @db.Uuid
  schoolId   String           @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  endedAt    DateTime?
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
  @@index([tenantId, schoolId, status])
}

model DigitalClassroom {
  id             String                   @id @default(uuid()) @db.Uuid
  tenantId       String                   @db.Uuid
  schoolId       String                   @db.Uuid
  classId        String?                  @db.Uuid
  ownerId        String                   @db.Uuid
  name           String
  code           String
  description    String?
  status         String                   @default("ACTIVE")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  archivedAt     DateTime?
  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
