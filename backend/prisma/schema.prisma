generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  OWNER
  SUPPORT
  AUDITOR
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum AccountType {
  APPLICATION_MANAGER
  TENANT_ADMIN
  STAFF
  TEACHER
  PARENT
  STUDENT
}

enum LoginEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TOKEN_REFRESHED
  SESSION_REVOKED
  LOGGED_OUT
  LOGGED_OUT_ALL
  EMAIL_VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum AttendanceSessionStatus {
  DRAFT
  OPEN
  LOCKED
  ARCHIVED
}

enum AttendanceCaptureMethod {
  MANUAL
  BIOMETRIC
  QR_CODE
  IMPORT
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  TRANSFERRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

enum TeacherStatus {
  APPLICANT
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ClassStatus {
  PLANNED
  ACTIVE
  CANCELLED
  ARCHIVED
}

enum AcademicPolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Tenant {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  code               String               @unique
  status             TenantStatus         @default(PENDING)
  timezone           String               @default("UTC")
  currency           String               @default("USD")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  users              User[]
  schools            School[]
  roles              Role[]
  academicYears      AcademicYear[]
  students           Student[]
  guardians          Guardian[]
  staff              Staff[]
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  attendanceSessions AttendanceSession[]
  attendanceAudits   AttendanceAudit[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  settings           TenantSetting[]
  parents            Parent[]
  teachers           Teacher[]
  subjects           Subject[]
  gradeLevels        GradeLevel[]
  classrooms         Classroom[]
  classes            Class[]
  classEnrollments   ClassEnrollment[]
  gradeSchemes       GradeScheme[]
  gradeSchemeHistory GradeSchemeHistory[]

  @@index([status])
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  tenantId           String?                  @db.Uuid
  email              String                   @unique
  firstName          String
  lastName           String
  phone              String?
  passwordHash       String?
  accountType        AccountType              @default(TENANT_ADMIN)
  status             UserStatus               @default(INVITED)
  platformRole       PlatformRole?
  emailVerifiedAt    DateTime?
  failedLoginCount   Int                      @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  tenant             Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  roles              UserRole[]
  devices            UserDevice[]
  sessions           UserSession[]
  staff              Staff?
  notifications      Notification[]
  auditLogs          AuditLog[]
  loginAttempts      LoginAttempt[]
  auditLogins        AuditLogin[]
  refreshTokens      RefreshToken[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  trustedDevices     TrustedDevice[]
  activationRequests ActivationRequest[]      @relation("ActivationApplicant")
  ownedActivations   ActivationRequest[]      @relation("ActivationOwner")
  profile            UserProfile?
  preference         UserPreference?
  userAudits         UserAudit[]              @relation("UserAuditSubject")
  actedUserAudits    UserAudit[]              @relation("UserAuditActor")
  parent             Parent?
  teacher            Teacher?

  @@index([tenantId, status])
}

model School {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @db.Uuid
  name               String
  code               String
  address            String?
  city               String?
  country            String?
  phone              String?
  email              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses           Campus[]
  parents            Parent[]
  teachers           Teacher[]
  subjects           Subject[]
  gradeLevels        GradeLevel[]
  classrooms         Classroom[]
  classes            Class[]
  classEnrollments   ClassEnrollment[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  attendanceAudits   AttendanceAudit[]
  gradeSchemes       GradeScheme[]
  gradeSchemeHistory GradeSchemeHistory[]

  @@unique([tenantId, code])
}

model Campus {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name     String
  code     String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  code        String
  description String?
  deletedAt   DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  revokedAt DateTime?
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserDevice {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  deviceFingerprint String
  platform          String?
  pushToken         String?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
}

model UserSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  deviceName    String?
  deviceType    String?
  deviceHash    String?
  ipAddress     String?
  userAgent     String?
  lastActiveAt  DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogins   AuditLogin[]

  @@index([userId, expiresAt])
}

model AcademicYear {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  startsOn    DateTime
  endsOn      DateTime
  isCurrent   Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms       AcademicTerm[]
  enrollments Enrollment[]
  classes     Class[]

  @@unique([tenantId, name])
}

model AcademicTerm {
  id                 String              @id @default(uuid()) @db.Uuid
  academicYearId     String              @db.Uuid
  name               String
  startsOn           DateTime
  endsOn             DateTime
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]

  @@unique([academicYearId, name])
}

model Student {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @db.Uuid
  admissionNumber     String
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  gender              Gender                      @default(UNSPECIFIED)
  email               String?
  phone               String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians           StudentGuardian[]
  enrollments         Enrollment[]
  attendanceRecords   AttendanceRecord[]
  parentRelationships ParentStudentRelationship[]
  classEnrollments    ClassEnrollment[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([tenantId, lastName])
}

model StudentGuardian {
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  relationship String
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Parent {
  id            String                      @id @default(uuid()) @db.Uuid
  tenantId      String                      @db.Uuid
  userId        String                      @unique @db.Uuid
  schoolId      String?                     @db.Uuid
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  deletedAt     DateTime?
  tenant        Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School?                     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  profile       ParentProfile?
  relationships ParentStudentRelationship[]
  accessLogs    ParentAccessLog[]

  @@index([tenantId, schoolId])
}

model ParentProfile {
  parentId          String  @id @db.Uuid
  firstName         String
  lastName          String
  occupation        String?
  preferredLanguage String  @default("en")
  parent            Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model ParentStudentRelationship {
  parentId          String    @db.Uuid
  studentId         String    @db.Uuid
  relationship      String
  status            String    @default("PENDING")
  canViewAcademic   Boolean   @default(true)
  canViewAttendance Boolean   @default(true)
  canViewFees       Boolean   @default(true)
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  parent            Parent    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student           Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId, status])
}

model ParentAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  resource  String
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
}

model Teacher {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  schoolId       String                 @db.Uuid
  userId         String?                @unique @db.Uuid
  employeeNumber String
  status         TeacherStatus          @default(APPLICANT)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile        TeacherProfile?
  employment     TeacherEmployment?
  qualifications TeacherQualification[]
  certifications TeacherCertification[]
  departments    TeacherDepartment[]
  availability   TeacherAvailability[]
  history        TeacherHistory[]
  classes        ClassTeacher[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, schoolId, status])
}

model TeacherProfile {
  teacherId String  @id @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherEmployment {
  teacherId      String    @id @db.Uuid
  jobTitle       String
  employmentType String
  startDate      DateTime
  endDate        DateTime?
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherQualification {
  id          String    @id @default(uuid()) @db.Uuid
  teacherId   String    @db.Uuid
  title       String
  institution String?
  awardedOn   DateTime?
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model TeacherCertification {
  id        String    @id @default(uuid()) @db.Uuid
  teacherId String    @db.Uuid
  name      String
  issuer    String?
  expiresOn DateTime?
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model TeacherDepartment {
  id         String  @id @default(uuid()) @db.Uuid
  teacherId  String  @db.Uuid
  department String
  isPrimary  Boolean @default(false)
  teacher    Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, department])
}

model TeacherAvailability {
  id        String  @id @default(uuid()) @db.Uuid
  teacherId String  @db.Uuid
  dayOfWeek Int
  startsAt  String
  endsAt    String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, dayOfWeek])
}

model TeacherHistory {
  id         String        @id @default(uuid()) @db.Uuid
  teacherId  String        @db.Uuid
  fromStatus TeacherStatus
  toStatus   TeacherStatus
  reason     String?
  actorId    String?       @db.Uuid
  createdAt  DateTime      @default(now())
  teacher    Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

model Subject {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  schoolId          String             @db.Uuid
  code              String
  name              String
  description       String?
  status            SubjectStatus      @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes           ClassSubject[]
  assessmentWeights AssessmentWeight[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId, status, name])
}

model GradeScheme {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  schoolId      String               @db.Uuid
  name          String
  code          String
  passMark      Float
  status        AcademicPolicyStatus @default(DRAFT)
  effectiveFrom DateTime             @db.Date
  effectiveTo   DateTime?            @db.Date
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bands         GradeBand[]
  weights       AssessmentWeight[]
  history       GradeSchemeHistory[]

  @@unique([tenantId, schoolId, code])
  @@index([tenantId, schoolId, status, effectiveFrom])
}

model GradeBand {
  id        String      @id @default(uuid()) @db.Uuid
  schemeId  String      @db.Uuid
  label     String
  minMark   Float
  maxMark   Float
  point     Float
  remark    String?
  sortOrder Int         @default(0)
  scheme    GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, label])
  @@index([schemeId, sortOrder])
}

model AssessmentWeight {
  id        String      @id @default(uuid()) @db.Uuid
  schemeId  String      @db.Uuid
  subjectId String?     @db.Uuid
  name      String
  code      String
  weight    Float
  scheme    GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([schemeId, subjectId, code])
  @@index([schemeId, subjectId])
}

model GradeSchemeHistory {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @db.Uuid
  schoolId   String               @db.Uuid
  schemeId   String               @db.Uuid
  actorId    String?              @db.Uuid
  fromStatus AcademicPolicyStatus
  toStatus   AcademicPolicyStatus
  reason     String?
  createdAt  DateTime             @default(now())
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheme     GradeScheme          @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, schemeId, createdAt])
}

model GradeLevel {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  schoolId String  @db.Uuid
  name     String
  code     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes  Class[]

  @@unique([tenantId, schoolId, code])
}

model Classroom {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  schoolId String  @db.Uuid
  name     String
  code     String
  capacity Int
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes  Class[]

  @@unique([tenantId, schoolId, code])
}

model Class {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  schoolId           String              @db.Uuid
  academicYearId     String              @db.Uuid
  gradeLevelId       String              @db.Uuid
  classroomId        String?             @db.Uuid
  name               String
  code               String
  section            String?
  capacity           Int
  status             ClassStatus         @default(PLANNED)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  gradeLevel         GradeLevel          @relation(fields: [gradeLevelId], references: [id], onDelete: Restrict)
  classroom          Classroom?          @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  enrollments        ClassEnrollment[]
  teachers           ClassTeacher[]
  subjects           ClassSubject[]
  history            ClassHistory[]
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, schoolId, academicYearId, code])
  @@index([tenantId, schoolId, status])
}

model ClassEnrollment {
  classId    String           @db.Uuid
  studentId  String           @db.Uuid
  tenantId   String           @db.Uuid
  schoolId   String           @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  endedAt    DateTime?
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
  @@index([tenantId, schoolId, status])
}

model ClassTeacher {
  classId   String  @db.Uuid
  teacherId String  @db.Uuid
  isLead    Boolean @default(false)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
}

model ClassSubject {
  classId   String  @db.Uuid
  subjectId String  @db.Uuid
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([classId, subjectId])
}

model ClassHistory {
  id         String      @id @default(uuid()) @db.Uuid
  classId    String      @db.Uuid
  fromStatus ClassStatus
  toStatus   ClassStatus
  actorId    String?     @db.Uuid
  reason     String?
  createdAt  DateTime    @default(now())
  class      Class       @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
}

model Staff {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  userId         String? @unique @db.Uuid
  employeeNumber String
  firstName      String
  lastName       String
  department     String?
  jobTitle       String?
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeNumber])
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  gradeLevel     String
  section        String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([tenantId, gradeLevel, section])
}

model AttendanceRecord {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @db.Uuid
  schoolId       String?                 @db.Uuid
  sessionId      String?                 @db.Uuid
  studentId      String                  @db.Uuid
  attendanceDate DateTime?               @db.Date
  status         AttendanceStatus
  method         AttendanceCaptureMethod @default(MANUAL)
  note           String?
  recordedById   String?                 @db.Uuid
  markedById     String?                 @db.Uuid
  markedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school         School?                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session        AttendanceSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceDate])
  @@unique([sessionId, studentId])
  @@index([tenantId, attendanceDate, status])
  @@index([tenantId, schoolId, sessionId])
}

model AttendanceSession {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  schoolId    String                  @db.Uuid
  classId     String                  @db.Uuid
  periodId    String?                 @db.Uuid
  sessionDate DateTime                @db.Date
  title       String
  status      AttendanceSessionStatus @default(DRAFT)
  createdById String?                 @db.Uuid
  openedAt    DateTime?
  lockedAt    DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class       Class                   @relation(fields: [classId], references: [id], onDelete: Cascade)
  period      AcademicTerm?           @relation(fields: [periodId], references: [id], onDelete: SetNull)
  records     AttendanceRecord[]
  audits      AttendanceAudit[]

  @@unique([classId, sessionDate, periodId])
  @@index([tenantId, schoolId, sessionDate, status])
}

model AttendanceAudit {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  schoolId  String            @db.Uuid
  sessionId String            @db.Uuid
  actorId   String?           @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime          @default(now())
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, sessionId, createdAt])
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  recipientId String?             @db.Uuid
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  subject     String?
  body        String
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient   User?               @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model RefreshToken {
  id            String      @id @default(uuid()) @db.Uuid
  tokenHash     String      @unique
  userId        String      @db.Uuid
  sessionId     String      @db.Uuid
  parentTokenId String?     @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([sessionId, revokedAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  email         String
  ipAddress     String?
  userAgent     String?
  succeeded     Boolean
  failureReason String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, succeeded, createdAt])
  @@index([ipAddress, succeeded, createdAt])
}

model AuditLogin {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  sessionId String?        @db.Uuid
  event     LoginEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  session   UserSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  fingerprint String
  name        String?
  userAgent   String?
  lastIp      String?
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model ActivationRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  ownerUserId String    @db.Uuid
  email       String
  firstName   String?
  lastName    String?
  designation String?
  status      String    @default("PENDING")
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  applicant   User      @relation("ActivationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  owner       User      @relation("ActivationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status, createdAt])
  @@index([userId, status])
}

model UserProfile {
  userId      String  @id @db.Uuid
  designation String?
  firstName   String?
  lastName    String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  userId   String @id @db.Uuid
  locale   String @default("en")
  timezone String @default("UTC")
  settings Json?
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAudit {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  subject   User     @relation("UserAuditSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  actor     User?    @relation("UserAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subjectId, createdAt])
}

model DatabaseSentinel {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
}

model Examination {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
  name        String
  code        String
  status      String   @default("DRAFT")
  createdById String?  @db.Uuid
  lockedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([tenantId, schoolId, code])
}

model ExaminationCandidate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  schoolId      String   @db.Uuid
  examinationId String   @db.Uuid
  studentId     String   @db.Uuid
  classId       String?  @db.Uuid
  createdAt     DateTime @default(now())
  @@unique([examinationId, studentId])
}

model ExaminationMark {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  schoolId      String   @db.Uuid
  examinationId String   @db.Uuid
  candidateId   String   @db.Uuid
  subjectCode   String
  marks         Decimal  @db.Decimal(5, 2)
  recordedById  String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([examinationId, candidateId, subjectCode])
}

model ExaminationSchedule {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  schoolId      String   @db.Uuid
  examinationId String   @db.Uuid
  subjectCode   String
  classId       String?  @db.Uuid
  scheduledAt   DateTime?
  createdAt     DateTime @default(now())
  @@unique([examinationId, subjectCode, classId])
}

model ExaminationAudit {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  schoolId      String   @db.Uuid
  examinationId String   @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
}

model Result {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  schoolId      String   @db.Uuid
  examinationId String   @db.Uuid
  studentId     String   @db.Uuid
  schemeId      String   @db.Uuid
  status        String   @default("REVIEW")
  studentStatus String
  total         Decimal  @default(0) @db.Decimal(8, 2)
  average       Decimal  @default(0) @db.Decimal(6, 2)
  grade         String?
  gradePoint    Decimal? @db.Decimal(5, 2)
  position      Int?
  processedAt   DateTime?
  publishedAt   DateTime?
  lockedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([examinationId, studentId])
}

model ResultAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  schoolId  String   @db.Uuid
  resultId  String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
}
