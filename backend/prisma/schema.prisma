model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  intentId String @db.Uuid
  attemptNumber Int
  providerId String? @db.Uuid
  externalReference String?
  providerStatus String?
  status GatewayAttemptStatus @default(CREATED)
  errorCode String?
  errorMessage String?
  retryCount Int @default(0)
  requestedAt DateTime @default(now())
  respondedAt DateTime?
  durationMs Int?
  intent PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  @@unique([intentId, attemptNumber])
  @@index([providerId, externalReference])
}
model ExternalTransaction {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  schoolId String @db.Uuid
  intentId String? @db.Uuid
  attemptId String? @db.Uuid
  providerId String @db.Uuid
  externalReference String @db.VarChar(160)
  amountMinor Int
  currency String @db.VarChar(3)
  status String @db.VarChar(50)
  rawMetadata Json
  createdAt DateTime @default(now())
  @@unique([providerId, externalReference])
  @@index([tenantId, schoolId, intentId])
}
model GatewayWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  schoolId String @db.Uuid
  providerId String @db.Uuid
  eventId String @db.VarChar(180)
  eventType String @db.VarChar(100)
  signatureValid Boolean @default(false)
  processedAt DateTime?
  payload Json
  createdAt DateTime @default(now())
  @@unique([providerId, eventId])
  @@index([tenantId, schoolId, processedAt])
}
model GatewayRefund {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  schoolId String @db.Uuid
  intentId String @db.Uuid
  providerId String @db.Uuid
  amountMinor Int
  externalReference String?
  status String @db.VarChar(50)
  metadata Json
  createdAt DateTime @default(now())
  @@index([tenantId, schoolId, intentId])
}
model ProviderHealthStatus {
  id String @id @default(uuid()) @db.Uuid
  providerId String @unique @db.Uuid
  healthy Boolean
  latencyMs Int?
  lastCheckedAt DateTime @default(now())
  errorMessage String?
}
model GatewayError {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  schoolId String @db.Uuid
  providerId String? @db.Uuid
  intentId String? @db.Uuid
  code String @db.VarChar(80)
  message String @db.VarChar(500)
  metadata Json
  createdAt DateTime @default(now())
  @@index([tenantId, schoolId, createdAt])
}

model FinanceAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  schoolId  String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(80)
  entityId  String   @db.Uuid
  metadata  Json
  createdAt DateTime @default(now())

  @@index([tenantId, schoolId, createdAt])
}

enum AcademicPeriodStatus {
  PLANNED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AcademicPeriodType {
  YEAR
  TERM
  SEMESTER
  QUARTER
  BREAK
  HOLIDAY
  EXAM
  SPECIAL
}

model AcademicPeriod {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @db.Uuid
  schoolId           String                  @db.Uuid
  parentId           String?                 @db.Uuid
  name               String                  @db.VarChar(160)
  code               String                  @db.VarChar(60)
  type               AcademicPeriodType
  status             AcademicPeriodStatus    @default(PLANNED)
  startsAt           DateTime
  endsAt             DateTime
  lockedAt           DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  school             School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parent             AcademicPeriod?         @relation("AcademicPeriodHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           AcademicPeriod[]        @relation("AcademicPeriodHierarchy")
  history            AcademicPeriodHistory[]
  attendanceSessions AttendanceSession[]
  examinations       Examination[]
  timetables         Timetable[]

  @@unique([schoolId, code])
  @@index([tenantId, schoolId, type, status])
  @@index([schoolId, startsAt, endsAt])
}

model AcademicPeriodHistory {
  id         String                @id @default(uuid()) @db.Uuid
  periodId   String                @db.Uuid
  fromStatus AcademicPeriodStatus?
  toStatus   AcademicPeriodStatus
  reason     String?               @db.VarChar(500)
  actorId    String?               @db.Uuid
  createdAt  DateTime              @default(now())
  period     AcademicPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([periodId, createdAt])
}

enum AttendanceSessionStatus {
  DRAFT
  OPEN
  LOCKED
  ARCHIVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum AttendanceCaptureMethod {
  MANUAL
  QR
  RFID
  BIOMETRIC
  FACIAL
  IMPORT
}

model AttendanceSession {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @db.Uuid
  schoolId    String                  @db.Uuid
  classId     String                  @db.Uuid
  periodId    String?                 @db.Uuid
  sessionDate DateTime                @db.Date
  title       String                  @db.VarChar(160)
  status      AttendanceSessionStatus @default(DRAFT)
  openedAt    DateTime?
  lockedAt    DateTime?
  createdById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  school      School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class       Class                   @relation(fields: [classId], references: [id], onDelete: Restrict)
  period      AcademicPeriod?         @relation(fields: [periodId], references: [id], onDelete: SetNull)
  records     AttendanceRecord[]
  audits      AttendanceAudit[]
  qrTokens    AttendanceQrToken[]

  @@unique([schoolId, classId, sessionDate])
  @@index([tenantId, schoolId, sessionDate, status])
}

model AttendanceRecord {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  schoolId   String                  @db.Uuid
  sessionId  String                  @db.Uuid
  studentId  String                  @db.Uuid
  status     AttendanceStatus        @default(ABSENT)
  method     AttendanceCaptureMethod @default(MANUAL)
  note       String?                 @db.VarChar(500)
  markedAt   DateTime?
  markedById String?                 @db.Uuid
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  session    AttendanceSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student    Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([tenantId, schoolId, studentId, status])
}

model AttendanceAudit {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  schoolId  String            @db.Uuid
  sessionId String            @db.Uuid
  recordId  String?           @db.Uuid
  actorId   String?           @db.Uuid
  action    String            @db.VarChar(80)
  metadata  Json
  createdAt DateTime          @default(now())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([tenantId, schoolId, sessionId, createdAt])
}

model AttendanceQrToken {
  id        String            @id @default(uuid()) @db.Uuid
  sessionId String            @db.Uuid
  tokenHash String            @unique @db.VarChar(128)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
}

enum ExaminationStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  MARKING
  MODERATION
  APPROVAL
  LOCKED
  ARCHIVED
}

enum ExaminationCandidateStatus {
  REGISTERED
  ABSENT
  WITHDRAWN
  COMPLETED
}

enum MarkStatus {
  DRAFT
  SUBMITTED
  MODERATED
  APPROVED
  LOCKED
}

model Examination {
  id         String                 @id @default(uuid()) @db.Uuid
  tenantId   String                 @db.Uuid
  schoolId   String                 @db.Uuid
  periodId   String?                @db.Uuid
  name       String                 @db.VarChar(160)
  code       String                 @db.VarChar(60)
  status     ExaminationStatus      @default(DRAFT)
  startsAt   DateTime?
  endsAt     DateTime?
  lockedAt   DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  period     AcademicPeriod?        @relation(fields: [periodId], references: [id], onDelete: SetNull)
  candidates ExaminationCandidate[]
  schedules  ExaminationSchedule[]
  marks      ExaminationMark[]
  audits     ExaminationAudit[]
  results    Result[]

  @@unique([schoolId, code])
  @@index([tenantId, schoolId, status])
}

model ExaminationCandidate {
  id            String                     @id @default(uuid()) @db.Uuid
  tenantId      String                     @db.Uuid
  schoolId      String                     @db.Uuid
  examinationId String                     @db.Uuid
  studentId     String                     @db.Uuid
  status        ExaminationCandidateStatus @default(REGISTERED)
  createdAt     DateTime                   @default(now())
  examination   Examination                @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  student       Student                    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examinationId, studentId])
  @@index([tenantId, schoolId, studentId])
}

model ExaminationSchedule {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  schoolId      String      @db.Uuid
  examinationId String      @db.Uuid
  classId       String      @db.Uuid
  subjectCode   String      @db.VarChar(60)
  startsAt      DateTime
  endsAt        DateTime
  room          String?     @db.VarChar(80)
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  class         Class       @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([examinationId, classId, subjectCode])
  @@index([tenantId, schoolId, startsAt])
}

model ExaminationMark {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  schoolId      String      @db.Uuid
  examinationId String      @db.Uuid
  studentId     String      @db.Uuid
  subjectCode   String      @db.VarChar(60)
  score         Decimal     @db.Decimal(7, 2)
  maxScore      Decimal     @db.Decimal(7, 2)
  status        MarkStatus  @default(DRAFT)
  submittedAt   DateTime?
  approvedAt    DateTime?
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([examinationId, studentId, subjectCode])
  @@index([tenantId, schoolId, status])
}

model ExaminationAudit {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  schoolId      String      @db.Uuid
  examinationId String      @db.Uuid
  actorId       String?     @db.Uuid
  action        String      @db.VarChar(80)
  metadata      Json
  createdAt     DateTime    @default(now())
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Restrict)

  @@index([tenantId, schoolId, examinationId, createdAt])
}

enum ResultStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  PUBLISHED
  LOCKED
}

enum ResultStudentStatus {
  PASS
  FAIL
  INCOMPLETE
}

model GradeScheme {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  schoolId  String      @db.Uuid
  name      String      @db.VarChar(120)
  passMark  Decimal     @db.Decimal(5, 2)
  createdAt DateTime    @default(now())
  bands     GradeBand[]
  results   Result[]

  @@unique([schoolId, name])
  @@index([tenantId, schoolId])
}

model GradeBand {
  id       String      @id @default(uuid()) @db.Uuid
  schemeId String      @db.Uuid
  label    String      @db.VarChar(20)
  minMark  Decimal     @db.Decimal(5, 2)
  maxMark  Decimal     @db.Decimal(5, 2)
  point    Decimal     @db.Decimal(5, 2)
  scheme   GradeScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, label])
}

model Result {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  schoolId      String              @db.Uuid
  examinationId String              @db.Uuid
  studentId     String              @db.Uuid
  schemeId      String              @db.Uuid
  status        ResultStatus        @default(DRAFT)
  studentStatus ResultStudentStatus @default(INCOMPLETE)
  total         Decimal             @default(0) @db.Decimal(9, 2)
  average       Decimal             @default(0) @db.Decimal(7, 2)
  grade         String?             @db.VarChar(20)
  gradePoint    Decimal?            @db.Decimal(5, 2)
  position      Int?
  processedAt   DateTime?
  publishedAt   DateTime?
  lockedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  examination   Examination         @relation(fields: [examinationId], references: [id], onDelete: Restrict)
  student       Student             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  scheme        GradeScheme         @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  subjects      SubjectResult[]
  audits        ResultAudit[]

  @@unique([examinationId, studentId])
  @@index([tenantId, schoolId, status])
}

model SubjectResult {
  id          String   @id @default(uuid()) @db.Uuid
  resultId    String   @db.Uuid
  subjectCode String   @db.VarChar(60)
  total       Decimal  @db.Decimal(7, 2)
  average     Decimal  @db.Decimal(7, 2)
  grade       String?  @db.VarChar(20)
  gradePoint  Decimal? @db.Decimal(5, 2)
  passed      Boolean  @default(false)
  result      Result   @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, subjectCode])
}

model ResultAudit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  schoolId  String   @db.Uuid
  resultId  String   @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(80)
  metadata  Json
  createdAt DateTime @default(now())
  result    Result   @relation(fields: [resultId], references: [id], onDelete: Restrict)

  @@index([tenantId, schoolId, resultId, createdAt])
}

model SchoolAdministrator {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  schoolId   String    @db.Uuid
  userId     String    @db.Uuid
  assignedBy String?   @db.Uuid
  isPrimary  Boolean   @default(false)
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([tenantId, schoolId, revokedAt])
  @@index([userId, revokedAt])
}

enum TimetableStatus {
  DRAFT
  REVIEW
  PUBLISHED
  LOCKED
  ARCHIVED
}

enum TimetableConflictSeverity {
  HARD
  SOFT
}

enum TimetableEntryKind {
  LESSON
  BREAK
  FREE
  DOUBLE
  PRACTICAL
  LABORATORY
}

model Timetable {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @db.Uuid
  schoolId         String                 @db.Uuid
  academicPeriodId String                 @db.Uuid
  name             String                 @db.VarChar(160)
  academicYear     String                 @db.VarChar(40)
  status           TimetableStatus        @default(DRAFT)
  version          Int                    @default(1)
  publishedAt      DateTime?
  lockedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  academicPeriod   AcademicPeriod         @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  versions         TimetableVersion[]
  entries          ScheduleEntry[]
  slots            TimeSlot[]
  constraints      SchedulingConstraint[]
  conflicts        SchedulingConflict[]
  substitutions    ScheduleSubstitution[]
  audits           TimetableAudit[]

  @@unique([schoolId, academicPeriodId, name])
  @@index([tenantId, schoolId, status])
}

model TimetableVersion {
  id          String    @id @default(uuid()) @db.Uuid
  timetableId String    @db.Uuid
  number      Int
  snapshot    Json
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([timetableId, number])
}

model TimeSlot {
  id          String          @id @default(uuid()) @db.Uuid
  timetableId String          @db.Uuid
  weekday     Int
  startTime   String          @db.VarChar(5)
  endTime     String          @db.VarChar(5)
  label       String          @db.VarChar(80)
  isBreak     Boolean         @default(false)
  timetable   Timetable       @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  entries     ScheduleEntry[]

  @@unique([timetableId, weekday, startTime, endTime])
  @@index([timetableId, weekday, startTime])
}

model ScheduleEntry {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @db.Uuid
  schoolId      String                 @db.Uuid
  timetableId   String                 @db.Uuid
  timeSlotId    String                 @db.Uuid
  classId       String?                @db.Uuid
  teacherId     String?                @db.Uuid
  classroomId   String?                @db.Uuid
  subjectCode   String                 @db.VarChar(60)
  kind          TimetableEntryKind     @default(LESSON)
  duration      Int                    @default(1)
  notes         String?                @db.VarChar(500)
  timetable     Timetable              @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  timeSlot      TimeSlot               @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  class         Class?                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher       Teacher?               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  classroom     Classroom?             @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  conflicts     SchedulingConflict[]
  substitutions ScheduleSubstitution[]

  @@index([tenantId, schoolId, timetableId, timeSlotId])
  @@index([teacherId, timeSlotId])
  @@index([classId, timeSlotId])
  @@index([classroomId, timeSlotId])
}

model SchedulingConstraint {
  id            String                    @id @default(uuid()) @db.Uuid
  tenantId      String                    @db.Uuid
  schoolId      String                    @db.Uuid
  timetableId   String                    @db.Uuid
  code          String                    @db.VarChar(80)
  severity      TimetableConflictSeverity
  enabled       Boolean                   @default(true)
  configuration Json
  timetable     Timetable                 @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@unique([timetableId, code])
}

model SchedulingConflict {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @db.Uuid
  schoolId    String                    @db.Uuid
  timetableId String                    @db.Uuid
  entryId     String?                   @db.Uuid
  code        String                    @db.VarChar(80)
  severity    TimetableConflictSeverity
  message     String                    @db.VarChar(500)
  resolvedAt  DateTime?
  createdAt   DateTime                  @default(now())
  timetable   Timetable                 @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  entry       ScheduleEntry?            @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, timetableId, severity, resolvedAt])
}

model ScheduleSubstitution {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @db.Uuid
  schoolId            String        @db.Uuid
  timetableId         String        @db.Uuid
  entryId             String        @db.Uuid
  originalTeacherId   String?       @db.Uuid
  substituteTeacherId String?       @db.Uuid
  reason              String        @db.VarChar(500)
  startsAt            DateTime
  endsAt              DateTime
  createdBy           String?       @db.Uuid
  createdAt           DateTime      @default(now())
  timetable           Timetable     @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  entry               ScheduleEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  originalTeacher     Teacher?      @relation("SubstitutionTeacher", fields: [originalTeacherId], references: [id], onDelete: SetNull)

  @@index([tenantId, schoolId, timetableId, startsAt, endsAt])
}

model TimetableAudit {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  schoolId    String    @db.Uuid
  timetableId String    @db.Uuid
  actorId     String?   @db.Uuid
  action      String    @db.VarChar(80)
  metadata    Json
  createdAt   DateTime  @default(now())
  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@index([tenantId, schoolId, timetableId, createdAt])
}
