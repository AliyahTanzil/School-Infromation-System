generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
}

enum LoginEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGGED_OUT
  LOGGED_OUT_ALL
  TOKEN_REFRESHED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  SESSION_REVOKED
  ACCOUNT_LOCKED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum ProfileImageStatus {
  PENDING
  ACTIVE
  REPLACED
  DELETED
  REJECTED
}

enum UserAuditEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELETED
  RESTORED
  PROFILE_UPDATED
  PREFERENCE_UPDATED
  IMAGE_UPLOADED
  IMAGE_REPLACED
  IMAGE_DELETED
  IMAGE_REJECTED
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(320)
  passwordHash     String
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  loginAttempts           LoginAttempt[]
  sessions                UserSession[]
  trustedDevices          TrustedDevice[]
  auditLogins             AuditLogin[]
  profile                 UserProfile?
  preference              UserPreference?
  profileImages           ProfileImage[]
  userAudits              UserAudit[]              @relation("UserAuditSubject")
  actorAudits             UserAudit[]              @relation("UserAuditActor")
  schoolAdministrators    SchoolAdministrator[]
  studentHistoryActors    StudentHistory[]        @relation("StudentHistoryActor")
  parent                Parent?
  teacher               Teacher?

  userRoles               UserRole[]               @relation("UserRoleSubject")
  assignedUserRoles       UserRole[]               @relation("UserRoleGrantedBy")
  grantedRolePermissions  RolePermission[]         @relation("RolePermissionGrantedBy")

  @@index([status])
  @@index([deletedAt])
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique
  userId        String    @db.Uuid
  sessionId     String    @db.Uuid
  parentTokenId String?   @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       UserSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  rotatedTokens RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  email         String   @db.VarChar(320)
  ipAddress     String   @db.VarChar(64)
  userAgent     String?  @db.VarChar(512)
  succeeded     Boolean
  failureReason String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceName   String?   @db.VarChar(255)
  deviceType   String?   @db.VarChar(50)
  deviceHash   String?   @db.VarChar(255)
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(512)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogins   AuditLogin[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  fingerprint String    @db.VarChar(255)
  name        String?   @db.VarChar(255)
  userAgent   String?   @db.VarChar(512)
  lastIp      String?   @db.VarChar(64)
  lastSeenAt  DateTime  @default(now())
  trustedAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, revokedAt])
}

model AuditLogin {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  sessionId String?        @db.Uuid
  event     LoginEventType
  ipAddress String?        @db.VarChar(64)
  userAgent String?        @db.VarChar(512)
  metadata  Json?
  createdAt DateTime       @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([event, createdAt])
}

model PermissionGroup {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(100)
  name        String    @db.VarChar(150)
  description String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions Permission[]

  @@index([deletedAt])
}

model Permission {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique @db.VarChar(150)
  name              String           @db.VarChar(150)
  description       String?
  effect            PermissionEffect @default(ALLOW)
  isSystem          Boolean          @default(false)
  permissionGroupId String           @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  permissionGroup PermissionGroup  @relation(fields: [permissionGroupId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]

  @@index([permissionGroupId, deletedAt])
  @@index([deletedAt])
}

model Role {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(150)
  description  String?
  isSystem     Boolean   @default(false)
  isAssignable Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  parentRelationships RoleHierarchy[]  @relation("RoleHierarchyParent")
  childRelationships  RoleHierarchy[]  @relation("RoleHierarchyChild")

  @@index([deletedAt])
  @@index([isSystem, deletedAt])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([grantedById])
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeKey    String    @default("global") @db.VarChar(255)
  grantedById String?   @db.Uuid
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User  @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, scopeKey])
  @@index([roleId, revokedAt])
  @@index([userId, scopeKey, revokedAt, expiresAt])
  @@index([grantedById])
}

model RoleHierarchy {
  id           String   @id @default(uuid()) @db.Uuid
  parentRoleId String   @db.Uuid
  childRoleId  String   @db.Uuid
  createdAt    DateTime @default(now())

  parentRole Role @relation("RoleHierarchyParent", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRole  Role @relation("RoleHierarchyChild", fields: [childRoleId], references: [id], onDelete: Cascade)

  @@unique([parentRoleId, childRoleId])
  @@index([childRoleId])
}

model UserProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  preferredName  String?  @db.VarChar(100)
  phone          String?  @db.VarChar(40)
  dateOfBirth    DateTime?
  address        String?  @db.VarChar(500)
  city           String?  @db.VarChar(100)
  country        String?  @db.VarChar(100)
  completionPct  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  locale      String   @default("en") @db.VarChar(20)
  timezone    String   @default("UTC") @db.VarChar(80)
  theme       String   @default("system") @db.VarChar(20)
  emailAlerts Boolean  @default(true)
  smsAlerts   Boolean  @default(false)
  profileVisible Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileImage {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @db.Uuid
  objectKey    String             @db.VarChar(500)
  thumbnailKey String?            @db.VarChar(500)
  mimeType     String             @db.VarChar(100)
  byteSize     Int
  width        Int?
  height       Int?
  checksum     String             @db.VarChar(128)
  status       ProfileImageStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model UserAudit {
  id         String            @id @default(uuid()) @db.Uuid
  actorId    String?           @db.Uuid
  subjectId  String            @db.Uuid
  eventType  UserAuditEventType
  scopeKey   String            @default("global") @db.VarChar(255)
  beforeJson Json?
  afterJson  Json?
  changedFields Json?
  requestId  String?           @db.VarChar(100)
  ipAddress  String?           @db.VarChar(64)
  userAgent  String?           @db.VarChar(512)
  success    Boolean           @default(true)
  reason     String?           @db.VarChar(500)
  createdAt  DateTime          @default(now())

  actor   User? @relation("UserAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subject User  @relation("UserAuditSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(120)
  status    String   @default("ACTIVE") @db.VarChar(30)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]

  @@index([status, deletedAt])
}

model School {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String   @db.VarChar(200)
  slug           String   @db.VarChar(120)
  normalizedName String   @db.VarChar(200)
  email          String?  @db.VarChar(320)
  phone          String?  @db.VarChar(40)
  website        String?  @db.VarChar(300)
  status         String   @default("ACTIVE") @db.VarChar(30)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile        SchoolProfile?
  setting        SchoolSetting?
  configuration  SchoolConfiguration?
  branches       SchoolBranch[]
  departments    Department[]
  grades         GradeLevel[]
  administrators SchoolAdministrator[]
  students       Student[]
  teachers       Teacher[]

  @@unique([tenantId, slug])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, status, deletedAt])
}

model SchoolProfile {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @unique @db.Uuid
  description String?
  address     String?  @db.VarChar(500)
  city        String?  @db.VarChar(100)
  country     String?  @db.VarChar(100)
  logoUrl     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolSetting {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @unique @db.Uuid
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolConfiguration {
  id               String   @id @default(uuid()) @db.Uuid
  schoolId         String   @unique @db.Uuid
  timezone         String   @default("UTC") @db.VarChar(80)
  locale           String   @default("en") @db.VarChar(20)
  academicStructure String  @default("YEAR") @db.VarChar(30)
  featureFlags     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model SchoolBranch {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  schoolId       String   @db.Uuid
  name           String   @db.VarChar(160)
  code           String   @db.VarChar(40)
  normalizedName String   @db.VarChar(160)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, code])
  @@unique([schoolId, normalizedName])
  @@index([tenantId, schoolId, deletedAt])
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  schoolId       String   @db.Uuid
  branchId       String?  @db.Uuid
  name           String   @db.VarChar(160)
  code           String   @db.VarChar(40)
  normalizedName String   @db.VarChar(160)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, code])
  @@unique([schoolId, normalizedName])
  @@index([tenantId, schoolId, branchId, deletedAt])
}

model GradeLevel {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  schoolId       String   @db.Uuid
  name           String   @db.VarChar(120)
  code           String   @db.VarChar(40)
  displayOrder   Int
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([schoolId, code])
  @@unique([schoolId, displayOrder])
  @@index([tenantId, schoolId, deletedAt])
}

enum StudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

enum StudentDocumentStatus {
  PENDING
  ACTIVE
  REJECTED
  DELETED
}

model Student {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  schoolId          String        @db.Uuid
  admissionNumber   String        @db.VarChar(60)
  status            StudentStatus @default(APPLICANT)
  enrolledAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  profile           StudentProfile?
  admission         StudentAdmission?
  guardians         StudentGuardian[]
  medicalRecord     MedicalRecord?
  previousSchools   PreviousSchool[]
  documents         StudentDocument[]
  history           StudentHistory[]
  enrollments       StudentEnrollment[]
  classAssignments  StudentClassAssignment[]
  parentRelationships ParentStudentRelationship[]
  @@unique([schoolId, admissionNumber])
  @@index([tenantId, schoolId, status, deletedAt])
}

model StudentProfile {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @unique @db.Uuid
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  preferredName  String?  @db.VarChar(100)
  dateOfBirth    DateTime
  gender         String?  @db.VarChar(30)
  nationality    String?  @db.VarChar(100)
  email          String?  @db.VarChar(320)
  phone          String?  @db.VarChar(40)
  address        String?  @db.VarChar(500)
  city           String?  @db.VarChar(100)
  country        String?  @db.VarChar(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentAdmission {
  id              String   @id @default(uuid()) @db.Uuid
  studentId       String   @unique @db.Uuid
  applicationDate DateTime @default(now())
  admissionDate   DateTime?
  entryGrade      String?  @db.VarChar(80)
  source          String?  @db.VarChar(120)
  notes           String?
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Guardian {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  schoolId  String   @db.Uuid
  firstName String   @db.VarChar(100)
  lastName  String   @db.VarChar(100)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(40)
  address   String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  links     StudentGuardian[]
  @@index([tenantId, schoolId, email])
}

model StudentGuardian {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  relationship String   @db.VarChar(60)
  isPrimary    Boolean  @default(false)
  canPickup    Boolean  @default(false)
  canContact   Boolean  @default(true)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  @@unique([studentId, guardianId])
}

model MedicalRecord {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @unique @db.Uuid
  bloodType      String?  @db.VarChar(10)
  allergies      String?
  conditions     String?
  medications    String?
  emergencyNotes String?
  updatedBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PreviousSchool {
  id          String   @id @default(uuid()) @db.Uuid
  studentId   String   @db.Uuid
  name        String   @db.VarChar(200)
  city        String?  @db.VarChar(100)
  country     String?  @db.VarChar(100)
  startDate   DateTime?
  endDate     DateTime?
  certificate String?  @db.VarChar(500)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentDocument {
  id         String                @id @default(uuid()) @db.Uuid
  studentId  String                @db.Uuid
  objectKey  String                @db.VarChar(500)
  name       String                @db.VarChar(200)
  mimeType   String                @db.VarChar(100)
  byteSize   Int
  checksum   String                @db.VarChar(128)
  status     StudentDocumentStatus @default(PENDING)
  uploadedBy String?               @db.Uuid
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  student    Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@index([studentId, status])
}

model StudentHistory {
  id         String        @id @default(uuid()) @db.Uuid
  studentId  String        @db.Uuid
  fromStatus StudentStatus?
  toStatus   StudentStatus
  reason     String?
  actorId    String?       @db.Uuid
  createdAt  DateTime      @default(now())
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  actor       User?         @relation("StudentHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([studentId, createdAt])
}

model StudentEnrollment {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @db.Uuid
  schoolId     String   @db.Uuid
  academicYear String   @db.VarChar(40)
  grade        String?  @db.VarChar(80)
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([studentId, academicYear])
  @@index([schoolId, academicYear])
}

model StudentClassAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  studentId String   @db.Uuid
  schoolId  String   @db.Uuid
  className String   @db.VarChar(100)
  startsAt  DateTime
  endsAt    DateTime?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@index([schoolId, className, startsAt])
}

enum ParentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ParentRelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

model Parent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  schoolId    String   @db.Uuid
  userId      String   @unique @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  profile     ParentProfile?
  contacts    ParentContact[]
  addresses   ParentAddress[]
  preferences ParentPreference?
  notifications ParentNotificationSetting?
  relationships ParentStudentRelationship[]
  verifications ParentVerification[]
  accessLogs  ParentAccessLog[]
  events      ParentNotificationEvent[]
  @@index([tenantId, schoolId, deletedAt])
}

model ParentProfile {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String   @unique @db.Uuid
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  occupation  String?  @db.VarChar(160)
  preferredLanguage String? @db.VarChar(20)
  parent      Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ParentContact {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  type      String   @db.VarChar(20)
  value     String   @db.VarChar(320)
  isPrimary Boolean  @default(false)
  verifiedAt DateTime?
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@index([parentId, type])
}

model ParentAddress {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  label     String   @db.VarChar(40)
  address   String   @db.VarChar(500)
  city      String?  @db.VarChar(100)
  country   String?  @db.VarChar(100)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model ParentStudentRelationship {
  id           String                  @id @default(uuid()) @db.Uuid
  parentId     String                  @db.Uuid
  studentId    String                  @db.Uuid
  relationship String                  @db.VarChar(60)
  status       ParentRelationshipStatus @default(PENDING)
  canViewAcademic Boolean              @default(true)
  canViewAttendance Boolean            @default(true)
  canViewFees  Boolean                @default(false)
  verifiedAt   DateTime?
  revokedAt    DateTime?
  parent       Parent                  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  @@unique([parentId, studentId])
  @@index([studentId, status])
}

model ParentVerification {
  id         String                   @id @default(uuid()) @db.Uuid
  parentId   String                   @db.Uuid
  channel    String                   @db.VarChar(20)
  tokenHash  String                   @db.VarChar(128)
  status     ParentVerificationStatus @default(PENDING)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime                 @default(now())
  parent     Parent                   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@index([parentId, status, expiresAt])
}

model ParentPreference {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @unique @db.Uuid
  locale    String   @default("en") @db.VarChar(20)
  timezone  String   @default("UTC") @db.VarChar(80)
  theme     String   @default("system") @db.VarChar(20)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model ParentNotificationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String   @unique @db.Uuid
  announcements Boolean @default(true)
  attendance   Boolean @default(true)
  results      Boolean @default(true)
  fees        Boolean @default(false)
  parent      Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
}

model ParentAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  studentId String?  @db.Uuid
  resource  String   @db.VarChar(80)
  action    String   @db.VarChar(40)
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@index([parentId, createdAt])
}

model ParentNotificationEvent {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @db.Uuid
  type      String   @db.VarChar(60)
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  @@index([parentId, readAt, createdAt])
}

enum TeacherStatus {
  APPLICANT
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
}

model Teacher {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  schoolId       String       @db.Uuid
  userId         String?      @unique @db.Uuid
  employeeNumber String       @db.VarChar(60)
  status         TeacherStatus @default(APPLICANT)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile        TeacherProfile?
  qualifications TeacherQualification[]
  certifications TeacherCertification[]
  employment     TeacherEmployment?
  documents      TeacherDocument[]
  departments    TeacherDepartment[]
  subjects       TeacherSubjectAssignment[]
  classes        TeacherClassAssignment[]
  availability   TeacherAvailability[]
  history        TeacherHistory[]
  @@unique([schoolId, employeeNumber])
  @@index([tenantId, schoolId, status, deletedAt])
}

model TeacherProfile {
  id            String   @id @default(uuid()) @db.Uuid
  teacherId     String   @unique @db.Uuid
  firstName     String   @db.VarChar(100)
  lastName      String   @db.VarChar(100)
  email         String?  @db.VarChar(320)
  phone         String?  @db.VarChar(40)
  dateOfBirth   DateTime?
  gender        String?  @db.VarChar(30)
  nationality   String?  @db.VarChar(100)
  address       String?  @db.VarChar(500)
  emergencyName String?  @db.VarChar(160)
  emergencyPhone String? @db.VarChar(40)
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TeacherQualification {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @db.Uuid
  institution String   @db.VarChar(200)
  title       String   @db.VarChar(160)
  field       String?  @db.VarChar(160)
  awardedAt   DateTime?
  documentKey String?  @db.VarChar(500)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, awardedAt])
}

model TeacherCertification {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @db.Uuid
  name        String   @db.VarChar(160)
  issuer      String?  @db.VarChar(160)
  issuedAt    DateTime?
  expiresAt   DateTime?
  certificateKey String? @db.VarChar(500)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherEmployment {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @unique @db.Uuid
  jobTitle    String   @db.VarChar(160)
  employmentType String @db.VarChar(40)
  startDate   DateTime
  endDate     DateTime?
  salaryBand  String?  @db.VarChar(80)
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeacherDocument {
  id         String   @id @default(uuid()) @db.Uuid
  teacherId  String   @db.Uuid
  name       String   @db.VarChar(200)
  objectKey  String   @db.VarChar(500)
  mimeType   String   @db.VarChar(100)
  byteSize   Int
  checksum   String   @db.VarChar(128)
  createdAt  DateTime @default(now())
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, createdAt])
}

model TeacherDepartment {
  id           String   @id @default(uuid()) @db.Uuid
  teacherId    String   @db.Uuid
  departmentId String   @db.Uuid
  startsAt     DateTime
  endsAt       DateTime?
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@unique([teacherId, departmentId, startsAt])
}

model TeacherSubjectAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  teacherId    String   @db.Uuid
  subjectId    String   @db.Uuid
  academicYear String   @db.VarChar(40)
  term         String?  @db.VarChar(40)
  startsAt     DateTime
  endsAt       DateTime?
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  @@unique([teacherId, subjectId, academicYear, term])
  @@index([subjectId, academicYear])
}

model TeacherClassAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  teacherId    String   @db.Uuid
  classId      String   @db.Uuid
  role         String   @db.VarChar(60)
  academicYear String   @db.VarChar(40)
  term         String?  @db.VarChar(40)
  startsAt     DateTime
  endsAt       DateTime?
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  @@unique([teacherId, classId, academicYear, term])
  @@index([classId, academicYear])
}

model TeacherAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  teacherId String   @db.Uuid
  weekday  Int
  startTime String   @db.VarChar(10)
  endTime   String   @db.VarChar(10)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@index([teacherId, weekday])
}

model TeacherHistory {
  id         String       @id @default(uuid()) @db.Uuid
  teacherId  String       @db.Uuid
  fromStatus TeacherStatus?
  toStatus   TeacherStatus
  reason     String?
  actorId    String?      @db.Uuid
  createdAt  DateTime     @default(now())
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  @@index([teacherId, createdAt])
}

model SchoolAdministrator {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  schoolId   String   @db.Uuid
  userId     String   @db.Uuid
  assignedBy String?  @db.Uuid
  isPrimary  Boolean  @default(false)
  startsAt   DateTime @default(now())
  endsAt     DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([tenantId, schoolId, revokedAt])
  @@index([userId, revokedAt])
}
