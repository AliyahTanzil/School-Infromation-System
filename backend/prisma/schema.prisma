generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  SUSPENDED
}

enum LoginEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGGED_OUT
  LOGGED_OUT_ALL
  TOKEN_REFRESHED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  SESSION_REVOKED
  ACCOUNT_LOCKED
}

enum PermissionEffect {
  ALLOW
  DENY
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(320)
  passwordHash     String
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  loginAttempts           LoginAttempt[]
  sessions                UserSession[]
  trustedDevices          TrustedDevice[]
  auditLogins             AuditLogin[]
  userRoles               UserRole[]               @relation("UserRoleSubject")
  assignedUserRoles       UserRole[]               @relation("UserRoleGrantedBy")
  grantedRolePermissions  RolePermission[]         @relation("RolePermissionGrantedBy")

  @@index([status])
  @@index([deletedAt])
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique
  userId        String    @db.Uuid
  sessionId     String    @db.Uuid
  parentTokenId String?   @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  revokeReason  String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       UserSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parentToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [parentTokenId], references: [id], onDelete: SetNull)
  rotatedTokens RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique
  userId      String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  email         String   @db.VarChar(320)
  ipAddress     String   @db.VarChar(64)
  userAgent     String?  @db.VarChar(512)
  succeeded     Boolean
  failureReason String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceName   String?   @db.VarChar(255)
  deviceType   String?   @db.VarChar(50)
  deviceHash   String?   @db.VarChar(255)
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(512)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?   @db.VarChar(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  auditLogins   AuditLogin[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model TrustedDevice {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  fingerprint String    @db.VarChar(255)
  name        String?   @db.VarChar(255)
  userAgent   String?   @db.VarChar(512)
  lastIp      String?   @db.VarChar(64)
  lastSeenAt  DateTime  @default(now())
  trustedAt   DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, revokedAt])
}

model AuditLogin {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  sessionId String?        @db.Uuid
  event     LoginEventType
  ipAddress String?        @db.VarChar(64)
  userAgent String?        @db.VarChar(512)
  metadata  Json?
  createdAt DateTime       @default(now())

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([event, createdAt])
}

model PermissionGroup {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique @db.VarChar(100)
  name        String    @db.VarChar(150)
  description String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions Permission[]

  @@index([deletedAt])
}

model Permission {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique @db.VarChar(150)
  name              String           @db.VarChar(150)
  description       String?
  effect            PermissionEffect @default(ALLOW)
  isSystem          Boolean          @default(false)
  permissionGroupId String           @db.Uuid
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  permissionGroup PermissionGroup  @relation(fields: [permissionGroupId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]

  @@index([permissionGroupId, deletedAt])
  @@index([deletedAt])
}

model Role {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(100)
  name         String    @db.VarChar(150)
  description  String?
  isSystem     Boolean   @default(false)
  isAssignable Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  parentRelationships RoleHierarchy[]  @relation("RoleHierarchyParent")
  childRelationships  RoleHierarchy[]  @relation("RoleHierarchyChild")

  @@index([deletedAt])
  @@index([isSystem, deletedAt])
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@index([grantedById])
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  roleId      String    @db.Uuid
  scopeKey    String    @default("global") @db.VarChar(255)
  grantedById String?   @db.Uuid
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User  @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, scopeKey])
  @@index([roleId, revokedAt])
  @@index([userId, scopeKey, revokedAt, expiresAt])
  @@index([grantedById])
}

model RoleHierarchy {
  id           String   @id @default(uuid()) @db.Uuid
  parentRoleId String   @db.Uuid
  childRoleId  String   @db.Uuid
  createdAt    DateTime @default(now())

  parentRole Role @relation("RoleHierarchyParent", fields: [parentRoleId], references: [id], onDelete: Cascade)
  childRole  Role @relation("RoleHierarchyChild", fields: [childRoleId], references: [id], onDelete: Cascade)

  @@unique([parentRoleId, childRoleId])
  @@index([childRoleId])
}
