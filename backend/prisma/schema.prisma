generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  OWNER
  SUPPORT
  AUDITOR
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
  TRANSFERRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

model Tenant {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  code              String             @unique
  status            TenantStatus       @default(PENDING)
  timezone          String             @default("UTC")
  currency          String             @default("USD")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  users             User[]
  schools           School[]
  roles             Role[]
  academicYears     AcademicYear[]
  students          Student[]
  guardians         Guardian[]
  staff             Staff[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  settings          TenantSetting[]

  @@index([status])
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String?        @db.Uuid
  email         String         @unique
  firstName     String
  lastName      String
  phone         String?
  status        UserStatus     @default(INVITED)
  platformRole  PlatformRole?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  roles         UserRole[]
  devices       UserDevice[]
  sessions      UserSession[]
  staff         Staff?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([tenantId, status])
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  address   String?
  city      String?
  country   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses  Campus[]

  @@unique([tenantId, code])
}

model Campus {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  name     String
  code     String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String
  description String?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserDevice {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  deviceFingerprint String
  platform          String?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AcademicYear {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  name        String
  startsOn    DateTime
  endsOn      DateTime
  isCurrent   Boolean        @default(false)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms       AcademicTerm[]
  enrollments Enrollment[]

  @@unique([tenantId, name])
}

model AcademicTerm {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  name           String
  startsOn       DateTime
  endsOn         DateTime
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
}

model Student {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  admissionNumber   String
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  gender            Gender             @default(UNSPECIFIED)
  email             String?
  phone             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId, lastName, firstName])
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([tenantId, lastName])
}

model StudentGuardian {
  studentId    String   @db.Uuid
  guardianId   String   @db.Uuid
  relationship String
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

model Staff {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @db.Uuid
  userId         String? @unique @db.Uuid
  employeeNumber String
  firstName      String
  lastName       String
  department     String?
  jobTitle       String?
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeNumber])
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  studentId      String           @db.Uuid
  academicYearId String           @db.Uuid
  gradeLevel     String
  section        String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([tenantId, gradeLevel, section])
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  studentId      String           @db.Uuid
  attendanceDate DateTime         @db.Date
  status         AttendanceStatus
  note           String?
  recordedById   String?          @db.Uuid
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, attendanceDate])
  @@index([tenantId, attendanceDate, status])
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  recipientId String?             @db.Uuid
  channel     NotificationChannel
  status      NotificationStatus  @default(QUEUED)
  subject     String?
  body        String
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient   User?               @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  tenant     Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

model DatabaseSentinel {
  id        Int      @id @default(1)
  createdAt DateTime @default(now())
}
