# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
# Vercel project slug whose HTTPS production and preview aliases are allowed.
CORS_VERCEL_PREVIEW_PROJECT=school-administration-information-system-frontend

# ─── Database ─────────────────────────────────────────────
# Optional for local foundation-only startup; required in production.
DATABASE_URL=postgresql://sais_dev:sais_dev_local_only@localhost:5432/sais_dev?schema=public

# ─── Authentication ───────────────────────────────────────
# Local development values only. Replace both with independent high-entropy
# secrets in every shared, staging, or production environment.
JWT_ACCESS_SECRET=sais-local-access-secret-2026-do-not-use-in-production
JWT_REFRESH_SECRET=sais-local-refresh-secret-2026-do-not-use-in-production

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug

# Optional development account overrides. Never reuse these values in production.
SAIS_DEV_ACCOUNT_PASSWORD=ChangeMe!2026
SAIS_DEV_ADMIN_EMAIL=school-admin@example.test
SAIS_DEV_TEACHER_EMAIL=teacher@example.test
SAIS_DEV_STUDENT_EMAIL=student@example.test
SAIS_DEV_PARENT_EMAIL=parent@example.test
