# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://sais:sais_password@localhost:5432/sais?schema=public

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
