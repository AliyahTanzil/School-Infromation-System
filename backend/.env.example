# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# ─── Database ─────────────────────────────────────────────
# Optional for local foundation-only startup; required in production.
DATABASE_URL=postgresql://sais:sais_password@localhost:5432/sais?schema=public

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
