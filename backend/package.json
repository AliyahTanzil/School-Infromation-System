{
  "name": "sais-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=/vercel/share/.env.project --import tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test": "node --import tsx --test tests/foundation.test.ts",
    "test:unit": "node --import tsx --test tests/foundation.test.ts",
    "test:integration": "node --import tsx --test tests/foundation.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.37",
    "@prisma/client": "^5.22.0",
    "ai": "^7.0.59",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.4",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
